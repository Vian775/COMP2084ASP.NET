@model IEnumerable<DotNetDrinksWebUI.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<h1>Your Cart</h1>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th class="text-end">Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.Price.ToString("C")</td>
                <td class="text-end">
                    @(item.Quantity * item.Price).ToString("C")
                </td>
            </tr>
        }
    </tbody>
</table>
